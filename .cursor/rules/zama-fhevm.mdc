## Public Decryption Pattern (standalone)

```solidity
// Mark handle as publicly decryptable:
FHE.makePubliclyDecryptable(_result);

// Callback (exact signature required):
function onReveal(uint256 reqId, bytes memory ct, bytes memory sigs) public returns (bool) {
    require(msg.sender == address(FHE.getDecryptionOracle()), "Only oracle");
    FHE.checkSignatures(reqId, ct, sigs);
    uint64 value = abi.decode(ct, (uint64));
    emit ResultRevealed(value);
    return true;
}
```


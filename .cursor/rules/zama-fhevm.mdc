## Standalone Contract Defaults (`@fhevm/solidity`)

```solidity
import { FHE, euint64, externalEuint64, ebool } from "@fhevm/solidity";
// For Sepolia (upcoming main branch): import { SepoliaFHEVMConfig } from "@fhevm/solidity/config/FHEVMConfig.sol";
// For mainnet (v0.11.1):              import { ZamaEthereumConfig }  from "@fhevm/solidity/config/ZamaConfig.sol";
// For local Hardhat: no import — plugin auto-configures

contract MyVault /* is SepoliaFHEVMConfig for Sepolia */ {
    mapping(address => euint64) private _balances;

    // External inputs: always externalEuint64 + bytes proof → FHE.fromExternal
    function deposit(externalEuint64 encAmount, bytes calldata proof) external {
        euint64 amount = FHE.fromExternal(encAmount, proof);  // ← verify ZK proof first
        if (!FHE.isInitialized(_balances[msg.sender])) {     // ← FHE.isInitialized, not unwrap
            _balances[msg.sender] = FHE.asEuint64(0);
            FHE.allowThis(_balances[msg.sender]);
            FHE.allow(_balances[msg.sender], msg.sender);
        }
        _balances[msg.sender] = FHE.add(_balances[msg.sender], amount);
        FHE.allowThis(_balances[msg.sender]);          // ← REQUIRED after every assignment
        FHE.allow(_balances[msg.sender], msg.sender); // ← REQUIRED for user to re-encrypt
    }

    // Never branch on ebool — use FHE.select:
    function transfer(address to, euint64 amount) internal {
        ebool hasEnough = FHE.gte(_balances[msg.sender], amount);
        euint64 actual = FHE.select(hasEnough, amount, FHE.asEuint64(0)); // ✅
        // NOT: if (hasEnough) { ... }                                     // ❌ leaks branch
        _balances[msg.sender] = FHE.sub(_balances[msg.sender], actual);
        _balances[to] = FHE.add(_balances[to], actual);
        FHE.allowThis(_balances[msg.sender]); FHE.allow(_balances[msg.sender], msg.sender);
        FHE.allowThis(_balances[to]);         FHE.allow(_balances[to], to);
    }

    // View returns handle — caller re-encrypts off-chain (never returns plaintext):
    function balanceOf(address user) external view returns (euint64) {
        return _balances[user];
    }
}
```

**Network configs (standalone):**
```solidity
// Local Hardhat (plugin auto-configures — no class needed):
contract MyToken { }

// Sepolia testnet (upcoming @fhevm/solidity main branch):
import { SepoliaFHEVMConfig } from "@fhevm/solidity/config/FHEVMConfig.sol";
contract MyToken is SepoliaFHEVMConfig { }

// Ethereum mainnet (current @fhevm/solidity v0.11.1):
import { ZamaEthereumConfig } from "@fhevm/solidity/config/ZamaConfig.sol";
contract MyToken is ZamaEthereumConfig { }
```

### `FHE.isInitialized` — Use This, Not `unwrap`

```solidity
// ✅ CORRECT — works for all encrypted types (euint8–256, ebool, eaddress)
if (!FHE.isInitialized(_balances[user])) {
    _balances[user] = FHE.asEuint64(0);
    FHE.allowThis(_balances[user]);
    FHE.allow(_balances[user], user);
}

// ❌ AVOID — fragile, breaks on ebool; FHE.isInitialized is the official API
if (euint64.unwrap(_balances[user]) == 0) { ... }
```


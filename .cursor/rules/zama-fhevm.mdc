## Test Pattern

```typescript
// ✅ CORRECT: named import from "hardhat" — NOT `import hre from "hardhat"`
import { ethers, fhevm } from "hardhat";
import { FhevmType } from "@fhevm/hardhat-plugin";

beforeEach(async function () {
    // Gate to local mock only (remove for Sepolia-compatible tests):
    if (!fhevm.isMock) { this.skip(); }
});

// Encrypt and send — fluent chain, all awaited together:
const encrypted = await fhevm
    .createEncryptedInput(contractAddr, signer.address)
    .add64(1_000_000n)   // use add8/add16/add32/add64/addBool to match Solidity type
    .encrypt();
// encrypted.handles[0]  — Uint8Array handle (index matches addXX call order)
// encrypted.inputProof  — ZK proof binding all handles to (contract, signer)
await contract.deposit(encrypted.handles[0], encrypted.inputProof);

// Decrypt (only works if FHE.allow(handle, signer) was called in the contract):
const handle = await contract.balanceOf(signer.address);
const value = await fhevm.userDecryptEuint(
    FhevmType.euint64,   // must match actual encrypted type
    handle,
    contractAddr,
    signer               // MUST match who has FHE.allow — wrong signer returns 0n silently
);

// Multi-value batch (one proof, multiple handles):
const batch = await fhevm
    .createEncryptedInput(contractAddr, signer.address)
    .add64(1000n)   // handles[0]
    .add32(50)      // handles[1]
    .encrypt();
```

**`fhevm.isMock`** — `true` on local Hardhat, `false` on Sepolia/mainnet. Use to skip or branch:
```typescript
if (!fhevm.isMock) { this.skip(); }  // local-only test
if (fhevm.isMock)  { this.skip(); }  // Sepolia-only test
```


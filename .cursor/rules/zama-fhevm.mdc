## fhevm-contracts Extension Defaults

```solidity
import "fhevm/lib/TFHE.sol";
import { SepoliaZamaFHEVMConfig } from "fhevm/config/ZamaFHEVMConfig.sol";
import { ConfidentialERC20Mintable } from
    "fhevm-contracts/contracts/token/ERC20/extensions/ConfidentialERC20Mintable.sol";

contract MyToken is SepoliaZamaFHEVMConfig, ConfidentialERC20Mintable {
    constructor(address owner)
        ConfidentialERC20Mintable("MyToken", "MTK", owner)
    {
        _unsafeMint(owner, 1_000_000); // address first, amount second; 1 MTK (decimals=6)
        _totalSupply = 1_000_000;      // REQUIRED — _unsafeMint does NOT update totalSupply
    }
}

// If you need to override transfer logic, override _transferNoEvent (NOT _update):
contract MyTokenWithFee is SepoliaZamaFHEVMConfig, ConfidentialERC20Mintable {
    function _transferNoEvent(
        address from, address to, euint64 amount, ebool isTransferable
    ) internal virtual override {
        super._transferNoEvent(from, to, amount, isTransferable); // call parent first
        // Add custom logic with TFHE (not FHE):
        euint64 fee = TFHE.div(TFHE.mul(amount, 50), 10_000);
        _feePool = TFHE.add(_feePool, fee);
        TFHE.allowThis(_feePool);                 // ← REQUIRED after every TFHE assignment
        TFHE.allow(_feePool, _feeRecipient);      // ← REQUIRED for recipient access
    }
}
```

**Key fhevm-contracts facts:**
- `decimals()` → `6` (override if needed)
- `totalSupply()` → plaintext `uint64` (update manually: `_totalSupply += amount`)
- Transfer events use `_PLACEHOLDER = type(uint256).max` — not real amounts
- `_unsafeMint(address to, uint64 amount)` — address first, amount second; no overflow check

